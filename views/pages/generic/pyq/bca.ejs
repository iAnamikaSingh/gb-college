<% layout("layouts/boilerplate") %>
<section class="pyq-page" aria-labelledby="pyq-title">
  <header class="pyq-heading">
    <p class="pyq-eyebrow">Previous year questions</p>
    <h1 id="pyq-title">BCA Semester 2 question papers</h1>
    <p class="pyq-subtitle">Exam papers with solutions for the 2025-2028 batch</p>
  </header>

  <section class="combined-paper" aria-labelledby="combined-paper-title">
    <div class="combined-paper-copy">
      <h2 id="combined-paper-title">All papers in one PDF</h2>
      <p>View or download the complete Semester 2 collection.</p>
    </div>
    <div class="paper-actions">
      <a
        class="paper-button paper-button-primary"
        href="/pdfs/bca-sem2-all-question-papers.pdf"
        target="_blank"
        rel="noopener"
        >View combined PDF</a
      >
      <a
        class="paper-button paper-button-secondary"
        href="/pdfs/bca-sem2-all-question-papers.pdf"
        download="bca-sem2-all-question-papers.pdf"
        >Download combined PDF</a
      >
    </div>
  </section>

  <section class="subject-papers" aria-labelledby="subject-papers-title">
    <h2 id="subject-papers-title">Subject-wise papers</h2>
    <div class="pyq-table-wrapper">
      <table class="pyq-table">
        <caption>BCA Semester 2 papers with solutions</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Paper</th>
            <th scope="col">View</th>
            <th scope="col">Download</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>1</td>
            <th scope="row">2BCA 1</th>
            <td><a class="paper-button paper-button-small" href="/pdfs/2bca1-exam-paper-with-solutions.pdf" target="_blank" rel="noopener" aria-label="View 2BCA 1 paper with solutions">View</a></td>
            <td><a class="paper-button paper-button-small paper-button-secondary" href="/pdfs/2bca1-exam-paper-with-solutions.pdf" download="2bca1-exam-paper-with-solutions.pdf" aria-label="Download 2BCA 1 paper with solutions">Download</a></td>
          </tr>
          <tr>
            <td>2</td>
            <th scope="row">2BCA 2</th>
            <td><a class="paper-button paper-button-small" href="/pdfs/2bca2-exam-paper-with-solutions.pdf" target="_blank" rel="noopener" aria-label="View 2BCA 2 paper with solutions">View</a></td>
            <td><a class="paper-button paper-button-small paper-button-secondary" href="/pdfs/2bca2-exam-paper-with-solutions.pdf" download="2bca2-exam-paper-with-solutions.pdf" aria-label="Download 2BCA 2 paper with solutions">Download</a></td>
          </tr>
          <tr>
            <td>3</td>
            <th scope="row">2BCA 3</th>
            <td><a class="paper-button paper-button-small" href="/pdfs/2bca3-exam-paper-with-solutions.pdf" target="_blank" rel="noopener" aria-label="View 2BCA 3 paper with solutions">View</a></td>
            <td><a class="paper-button paper-button-small paper-button-secondary" href="/pdfs/2bca3-exam-paper-with-solutions.pdf" download="2bca3-exam-paper-with-solutions.pdf" aria-label="Download 2BCA 3 paper with solutions">Download</a></td>
          </tr>
          <tr>
            <td>4</td>
            <th scope="row">2BCA 4</th>
            <td><a class="paper-button paper-button-small" href="/pdfs/2bca4-exam-paper-with-solutions.pdf" target="_blank" rel="noopener" aria-label="View 2BCA 4 paper with solutions">View</a></td>
            <td><a class="paper-button paper-button-small paper-button-secondary" href="/pdfs/2bca4-exam-paper-with-solutions.pdf" download="2bca4-exam-paper-with-solutions.pdf" aria-label="Download 2BCA 4 paper with solutions">Download</a></td>
          </tr>
          <tr>
            <td>5</td>
            <th scope="row">2BCA 5</th>
            <td><a class="paper-button paper-button-small" href="/pdfs/2bca5-exam-paper-with-solutions.pdf" target="_blank" rel="noopener" aria-label="View 2BCA 5 paper with solutions">View</a></td>
            <td><a class="paper-button paper-button-small paper-button-secondary" href="/pdfs/2bca5-exam-paper-with-solutions.pdf" download="2bca5-exam-paper-with-solutions.pdf" aria-label="Download 2BCA 5 paper with solutions">Download</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <a class="paper-button paper-button-small" href="/admin/pyq/bca/new/exampaper" aria-label="add combined PDF">Add Question Paper PDF</a>
  <a class="paper-button paper-button-small paper-button-secondary" href="/admin/pyq/bca/new/exampaper-solution" aria-label="add solution PDF">Add Solution PDF</a>
</section>

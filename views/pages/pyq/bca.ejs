<% layout("layouts/boilerplate") %>
<%
  /* ------------------------------------------------------------
     ALL PDF DATA LIVES HERE. To add Semester 3, add one object.
     ------------------------------------------------------------ */
  const papersFor = (sem, years) =>
    [1, 2, 3, 4, 5].map((n) => ({
      label: `${sem}BCA ${n}`,
      file: `${sem}BCA${n}_${years}.pdf`,
    }));

  const semesters = [
    {
      number: 1,
      batches: [
        {
          years: "2025-2028",
          combined: "BCA_Sem1_Exam_Papers_2025-2028.pdf",
          papers: papersFor(1, "2025-2028"),
        },
        {
          years: "2024-2027",
          combined: "BCA_Sem1_Exam_Papers_2024-2027.pdf",
          papers: papersFor(1, "2024-2027"),
        },
      ],
    },
    {
      number: 2,
      batches: [
        {
          years: "2025-2028",
          combined: "bca-sem2-all-question-papers.pdf",
          papers: [1, 2, 3, 4, 5].map((n) => ({
            label: `2BCA ${n}`,
            file: `2bca${n}-exam-paper-with-solutions.pdf`,
          })),
        },
      ],
    },
  ];
%>

<div class="semester-picker">
  <label for="semester-select" class="semester-picker-label">Choose your semester</label>
  <select id="semester-select" class="semester-select">
    <option value="">Select Semester</option>
    <% semesters.forEach((s) => { %>
      <option value="<%= s.number %>" <%= s.number === 1 ? "selected" : "" %>>Semester <%= s.number %></option>
    <% }) %>
  </select>
</div>

<p id="semester-empty" class="semester-empty">
  Select a semester above to see its question papers and solutions.
</p>

<% semesters.forEach((s) => { %>
  <div class="semester-block" data-semester="<%= s.number %>" hidden>
    <section class="pyq-page" aria-labelledby="s<%= s.number %>-title">
      <header class="pyq-heading">
        <p class="pyq-eyebrow">Previous year question papers</p>
        <h1 id="s<%= s.number %>-title">BCA Semester <%= s.number %> question papers</h1>
        <p class="pyq-subtitle">Question papers and solutions, organized by academic batch.</p>
      </header>

    <% s.batches.forEach((b, bi) => { %>
      <% const id = `s${s.number}-b${bi}`; %>
      <section class="pyq-batch" aria-labelledby="<%= id %>-title">
        <header class="pyq-batch-heading">
          <h2 id="<%= id %>-title"><%= b.years %></h2>
        </header>

        <section class="combined-paper" aria-labelledby="<%= id %>-combined-title">
          <div class="combined-paper-copy">
            <h3 id="<%= id %>-combined-title">Complete paper collection</h3>
            <p>View or download the complete Semester <%= s.number %> collection.</p>
          </div>
          <div class="paper-actions">
            <a class="paper-button paper-button-primary"
               href="/pdfs/<%= b.combined %>" target="_blank" rel="noopener">View combined PDF</a>
            <a class="paper-button paper-button-secondary"
               href="/pdfs/<%= b.combined %>" download="<%= b.combined %>">Download combined PDF</a>
          </div>
        </section>

        <section class="subject-papers" aria-labelledby="<%= id %>-subjects">
          <h3 id="<%= id %>-subjects">Individual papers</h3>
          <div class="pyq-table-wrapper">
            <table class="pyq-table">
              <caption>BCA Semester <%= s.number %> papers with solutions (<%= b.years %>)</caption>
              <thead>
                <tr>
                  <th scope="col">No.</th>
                  <th scope="col">Paper</th>
                  <th scope="col">View</th>
                  <th scope="col">Download</th>
                </tr>
              </thead>
              <tbody>
                <% b.papers.forEach((p, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <th scope="row"><%= p.label %></th>
                    <td>
                      <a class="paper-button paper-button-small"
                         href="/pdfs/<%= p.file %>" target="_blank" rel="noopener"
                         aria-label="View <%= p.label %> paper with solutions">View</a>
                    </td>
                    <td>
                      <a class="paper-button paper-button-small paper-button-secondary"
                         href="/pdfs/<%= p.file %>" download="<%= p.file %>"
                         aria-label="Download <%= p.label %> paper with solutions">Download</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </section>
    <% }) %>
    </section>
  </div>
<% }) %>

<script>
  (function () {
    var select = document.getElementById("semester-select");
    var blocks = document.querySelectorAll(".semester-block");
    var empty = document.getElementById("semester-empty");

    function show(sem) {
      blocks.forEach(function (b) {
        b.hidden = b.dataset.semester !== sem;
      });
      empty.hidden = sem !== "";
    }

    select.addEventListener("change", function () {
      var sem = select.value;
      show(sem);
      var url = new URL(window.location);
      if (sem) url.searchParams.set("sem", sem);
      else url.searchParams.delete("sem");
      history.replaceState(null, "", url);
    });

    // Restore from ?sem=2 so the link is shareable / survives refresh
    var initial = new URLSearchParams(window.location.search).get("sem") || "1";
    if (initial && select.querySelector('option[value="' + initial + '"]')) {
      select.value = initial;
    } else {
      initial = "1";
      select.value = initial;
    }
    show(initial);
  })();
</script>

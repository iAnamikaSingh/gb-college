<% layout("layouts/boilerplate") %>
<div class="content">
  <h1>Welcome to Gram Bharti College Ramgarh</h1>
  <img src="/images/campus.webp" alt="College Image" class="college-img" />
  <p class="college-desc">
    Gram Bharti College, Ramgarh, Kaimur (Bihar), 821110, a constituent college
    of Veer Kunwar Singh University and a UGC-registered institution, offers a
    range of undergraduate programmes designed to support students in building
    strong academic and professional foundations.
    <br />
    The college offers four-year undergraduate programmes in Bachelor of Arts
    (B.A.), Bachelor of Science (B.Sc.), and Bachelor of Commerce (B.Com.) along
    with three-year professional programmes in Bachelor of Computer Applications
    (BCA), and Bachelor of Business Administrationg (BBA) both approved by
    AICTE.
  </p>

  <section class="recognition-section">
    <div class="section-heading">
      <h2>Recognition & Approvals</h2>
      <p>
        Verify the university recognition and programme approval through the
        respective official regulatory authorities.
      </p>
    </div>

    <div class="recognition-content">
      <h3>UGC Recognition</h3>
      <p>
        Verify the recognition of Veer Kunwar Singh University through the
        official UGC website.
      </p>

      <a
        href="https://www.ugc.gov.in/universitydetails/university?type=MuOh4z0uqRaY2k8Ag10I0g=="
        target="_blank"
        rel="noopener noreferrer"
      >
        Verify University Recognition
        <span><i class="fa-solid fa-square-arrow-up-right"></i></span>
      </a>
    </div>

    <div class="recognition-content">
      <h3>AICTE Approval</h3>
      <p>
        Verify the approval status of the BCA programme through the official
        AICTE portal.
      </p>

      <a
        href="https://facilities.aicte-india.org/dashboard/pages/angulardashboard.php#!/approved"
        target="_blank"
        rel="noopener noreferrer"
      >
        Verify AICTE Approval
        <span><i class="fa-solid fa-square-arrow-up-right"></i></span>
      </a>
    </div>
  </section>
  <div class=map-embed>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3607.1053406710366!2d83.6585722743806!3d25.3006646275039!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x398de374c0000001%3A0xf4efeeaf7bf7a027!2sGram%20Bharti%20College%20Ramgarh!5e0!3m2!1sen!2sin!4v1790609381525!5m2!1sen!2sin"
      title="Map showing Gram Bharti College"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
</div>

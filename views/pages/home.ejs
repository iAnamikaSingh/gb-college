<% layout("layouts/boilerplate") %>
<style>
  p {
    line-height: 2rem;
    font-size: large;
  }
</style>
<h1 style="line-height: 5rem">Welcome to Gram Bharti College Ramgarh</h1>
<img src="/images/campus.webp" height="300px" widt="500pxS"/>
<p>
  <strong>Gram Bharti College, Ramgarh, Kaimur (Bihar), 821110,</strong> a
  constituent college of <strong> Veer Kunwar Singh University</strong> and a
  UGC-registered institution, offers a range of undergraduate programmes
  designed to support students in building strong academic and professional
  foundations.
  <br />
  The college offers three-year professional programmes in Bachelor of Computer
  Applications <strong>(BCA)</strong>, and Bachelor of Business Administrationg
  <strong>(BBA)</strong> both approved by AICTE, along with four-year
  undergraduate programmes in Bachelor of Arts <strong>(B.A.)</strong>, Bachelor
  of Science <strong>(B.Sc.)</strong>, and Bachelor of Commerce
  <strong>(B.Com.)</strong>.
</p>

<div id="map"></div>

<section class="recognition-section">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Recognition & Approvals</span>
      <h2>Recognized & Approved</h2>
      <p>
        Verify the university recognition and programme approval through the
        respective official regulatory authorities.
      </p>
    </div>

    <div class="recognition-cards">
      <!-- UGC Recognition -->
      <div class="recognition-card">
        <div class="recognition-icon">
          <!-- UGC logo/icon -->
        </div>

        <div class="recognition-content">
          <span class="authority">University Grants Commission</span>
          <h3>UGC Recognition</h3>
          <p>
            Verify the recognition of Veer Kunwar Singh University through the
            official UGC website.
          </p>

          <a
            href="https://www.ugc.gov.in/universitydetails/university?type=MuOh4z0uqRaY2k8Ag10I0g=="
            target="_blank"
            rel="noopener noreferrer"
          >
            Verify University Recognition
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- AICTE Approval -->
      <div class="recognition-card">
        <div class="recognition-icon">
          <!-- AICTE logo/icon -->
        </div>

        <div class="recognition-content">
          <span class="authority">
            All India Council for Technical Education
          </span>
          <h3>AICTE Approval</h3>
          <p>
            Verify the approval status of the BCA programme through the official
            AICTE portal.
          </p>

          <a
            href="https://facilities.aicte-india.org/dashboard/pages/angulardashboard.php#!/approved"
            target="_blank"
            rel="noopener noreferrer"
          >
            Verify AICTE Approval
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

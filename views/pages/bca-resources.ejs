<% layout("layouts/boilerplate") %>

<section class="bca-resources" aria-labelledby="bca-resources-title">
  <header class="bca-resources-header">
    <p class="bca-resources-eyebrow">Student resources</p>
    <h1 id="bca-resources-title">BCA resources</h1>
    <p>Find course information and available documents for the Bachelor of Computer Applications programme.</p>
  </header>

  <nav class="bca-resource-jump" aria-label="BCA resource sections">
    <a href="#syllabus"><i class="fa-solid fa-book-open" aria-hidden="true"></i>Syllabus</a>
    <a href="#exam-papers"><i class="fa-solid fa-file-lines" aria-hidden="true"></i>Exam papers</a>
    <a href="#assignment-front-page"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>Assignment Front Page</a>
    <a href="#uniform"><i class="fa-solid fa-shirt" aria-hidden="true"></i>Uniform</a>
    <a href="#fees"><i class="fa-solid fa-indian-rupee-sign" aria-hidden="true"></i>Fees</a>
  </nav>

  <div class="bca-resource-sections">
    <section class="bca-resource-section" id="syllabus" aria-labelledby="bca-syllabus-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-book-open"></i></div>
      <div>
        <h2 id="bca-syllabus-title">Syllabus</h2>
        <p>BCA is listed as a three-year programme. A current semester-wise syllabus document is not published on this site.</p>
        <a class="bca-resource-link" href="https://gbcramgarh.in/" target="_blank" rel="noopener noreferrer">Check with the official college <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </div>
    </section>

    <section class="bca-resource-section" id="exam-papers" aria-labelledby="bca-exams-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-file-lines"></i></div>
      <div>
        <h2 id="bca-exams-title">Exam papers</h2>
        <p>Question papers and solutions are available for Semesters 1 and 2, including Semester 1 batches 2024–2027 and 2025–2028.</p>
        <a class="bca-resource-link" href="/pyq/bca">Browse BCA exam papers <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>

    <section class="bca-resource-section" id="assignment-front-page" aria-labelledby="bca-assignment-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-file-circle-plus"></i></div>
      <div>
        <h2 id="bca-assignment-title">Assignment Front Page</h2>
        <p>An official BCA assignment front-page template is not currently published on this site.</p>
        <a class="bca-resource-link" href="https://gbcramgarh.in/" target="_blank" rel="noopener noreferrer">Check with the official college <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </div>
    </section>

    <section class="bca-resource-section" id="uniform" aria-labelledby="bca-uniform-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-shirt"></i></div>
      <div>
        <h2 id="bca-uniform-title">Uniform</h2>
        <p>Verified BCA uniform requirements are not currently published on this site.</p>
        <a class="bca-resource-link" href="https://gbcramgarh.in/" target="_blank" rel="noopener noreferrer">Check with the official college <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </div>
    </section>

    <section class="bca-resource-section" id="fees" aria-labelledby="bca-fees-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-indian-rupee-sign"></i></div>
      <div>
        <h2 id="bca-fees-title">Fees</h2>
        <p class="bca-fee-disclaimer">Approximate figures shared for the 2025–2028 batch. This is not an officially confirmed fee schedule, and fees may change for future batches.</p>
        <dl class="bca-fee-breakdown">
          <div><dt>Semester 1</dt><dd>₹10,100</dd></div>
          <div><dt>Semester 2</dt><dd>₹10,700</dd></div>
          <div><dt>Semester 3</dt><dd>₹14,700</dd></div>
          <div><dt>Semesters 4–6</dt><dd>Approximately ₹11,000–₹15,000 each</dd></div>
        </dl>
        <p class="bca-fee-total"><strong>Estimated semester fees for all six semesters:</strong> ₹68,500–₹80,500, based on the figures above.</p>
        <p class="bca-fee-total"><strong>Examination fee:</strong> ₹1,000 per semester, or ₹6,000 for six semesters if the rate remains unchanged. Including this estimate, the combined total would be ₹74,500–₹86,500.</p>
        <p class="bca-fee-caution">The separately suggested overall estimate of ₹80,000–₹90,000 does not match the itemized ranges above; it may include other charges. For accurate, current fees, contact the HOD of BCA.</p>
        <a class="bca-resource-link" href="https://gbcramgarh.in/" target="_blank" rel="noopener noreferrer">Visit the official college website <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      </div>
    </section>
  </div>
</section>
<% layout("layouts/boilerplate") %>

<section class="bca-resources" aria-labelledby="bca-resources-title">
  <header class="bca-resources-header">
    <div class="bca-header-copy">
      <p class="bca-resources-eyebrow">Bachelor of Computer Applications</p>
      <h1 id="bca-resources-title">BCA student resources</h1>
      <p>Course documents, exam papers, assignment sheets, uniform details and fee estimates in one place.</p>
    </div>
    <dl class="bca-program-facts" aria-label="Programme overview">
      <div>
        <dt>Programme length</dt>
        <dd>3 years</dd>
      </div>
      <div>
        <dt>Available papers</dt>
        <dd>Semesters 1–2</dd>
      </div>
    </dl>
  </header>

  <nav class="bca-resource-jump" aria-label="BCA resource sections">
    <a href="#syllabus"><i class="fa-solid fa-book-open" aria-hidden="true"></i>Syllabus</a>
    <a href="#exam-papers"><i class="fa-solid fa-file-lines" aria-hidden="true"></i>Exam papers</a>
    <a href="#assignment-front-page"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>Assignments</a>
    <a href="#uniform"><i class="fa-solid fa-shirt" aria-hidden="true"></i>Uniform</a>
    <a href="#fees"><i class="fa-solid fa-indian-rupee-sign" aria-hidden="true"></i>Fees</a>
  </nav>

  <div class="bca-resource-sections">
    <section class="bca-resource-section" id="syllabus" aria-labelledby="bca-syllabus-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-book-open"></i></div>
      <div class="bca-resource-copy">
        <p class="bca-resource-kicker">Course document</p>
        <h2 id="bca-syllabus-title">BCA syllabus</h2>
        <p>View the syllabus in your browser or download the PDF for offline reference.</p>
        <div class="paper-actions">
          <a class="paper-button" href="/pdfs/bca_syllabus.pdf" target="_blank" rel="noopener">View syllabus</a>
          <a class="paper-button paper-button-secondary" href="/pdfs/bca_syllabus.pdf" download="bca_syllabus.pdf">Download PDF</a>
        </div>
      </div>
    </section>

    <section class="bca-resource-section" id="exam-papers" aria-labelledby="bca-exams-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-file-lines"></i></div>
      <div class="bca-resource-copy">
        <p class="bca-resource-kicker">Previous year questions</p>
        <h2 id="bca-exams-title">Exam papers and solutions</h2>
        <p>Semester 1 includes 2024–2027 and 2025–2028 batches. Semester 2 papers are listed for 2025–2028.</p>
        <div class="paper-actions">
          <a class="paper-button" href="/pyq/bca?sem=1">Semester 1 papers</a>
          <a class="paper-button paper-button-secondary" href="/pyq/bca?sem=2">Semester 2 papers</a>
        </div>
      </div>
    </section>

    <section class="bca-resource-section" id="assignment-front-page" aria-labelledby="bca-assignment-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-file-circle-plus"></i></div>
      <div class="bca-resource-copy">
        <p class="bca-resource-kicker">Ready-to-use PDF</p>
        <h2 id="bca-assignment-title">Assignment front pages</h2>
        <p>The combined PDF contains two front pages for preparing assignments for any semester.</p>
        <div class="paper-actions">
          <a class="paper-button" href="/pdfs/AssignmentFrontPage.pdf" target="_blank" rel="noopener">View front pages</a>
          <a class="paper-button paper-button-secondary" href="/pdfs/AssignmentFrontPage.pdf" download="AssignmentFrontPage.pdf">Download PDF</a>
        </div>
      </div>
    </section>

    <section class="bca-resource-section" id="uniform" aria-labelledby="bca-uniform-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-shirt"></i></div>
      <div class="bca-resource-copy">
        <p class="bca-resource-kicker">Student information</p>
        <h2 id="bca-uniform-title">Uniform</h2>
        <dl class="bca-uniform-list">
          <div><dt>Boys</dt><dd>Black pants, white shirt, black shoes and white socks.</dd></div>
          <div><dt>Girls</dt><dd>Black salwar, white suit and black dupatta. The listed boys' outfit is also an option.</dd></div>
        </dl>
      </div>
    </section>

    <section class="bca-resource-section bca-resource-section-fees" id="fees" aria-labelledby="bca-fees-title">
      <div class="bca-resource-icon" aria-hidden="true"><i class="fa-solid fa-indian-rupee-sign"></i></div>
      <div class="bca-resource-copy">
        <p class="bca-resource-kicker">2025–2028 batch · estimates</p>
        <h2 id="bca-fees-title">Fee guide</h2>
        <dl class="bca-fee-breakdown">
          <div><dt>Semester 1</dt><dd>₹10,100</dd></div>
          <div><dt>Semester 2</dt><dd>₹10,700</dd></div>
          <div><dt>Semester 3</dt><dd>₹14,700</dd></div>
          <div><dt>Semesters 4–6</dt><dd>About ₹11,000–₹15,000 each</dd></div>
        </dl>
        <div class="bca-fee-summary">
          <p><strong>Estimated semester fees:</strong> ₹68,500–₹80,500 across six semesters.</p>
          <p><strong>Including exams:</strong> ₹74,500–₹86,500 if the ₹1,000 per-semester exam fee stays unchanged.</p>
        </div>
        <p class="bca-fee-note">These are estimates, not official current rates. Fees may change; confirm the latest amount with the BCA HOD.</p>
      </div>
    </section>
  </div>
</section>
